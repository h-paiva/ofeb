    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[0]
      value: 'Bater em retirada!

'
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[1]
      value: Quase no fim... mas ainda estamos de pe!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[2]
      value: Nao podemos ceder agora!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[3]
      value: Resistam! Ainda temos uma chance!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[4]
      value: Estamos na ultima linha de defesa!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[5]
      value: Se caimos aqui, tudo estara perdido!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[6]
      value: Nao desistam! Ainda nao acabou!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[7]
      value: E tudo ou nada agora!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[8]
      value: So mais um pouco, aguentem firme!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[9]
      value: "A mare pode virar, segurem a posi\xE7ao!"
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[10]
      value: Estamos a beira da derrota... mas ainda vivos!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[11]
      value: Nao deixem o medo vencer!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[12]
      value: Cada segundo conta, mantenham a linha!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[13]
      value: "Estamos nos ultimos passos \u2014 nao parem!"
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[14]
      value: A queda e iminente se recuarmos!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[15]
      value: "Nao temos para onde correr \u2014 so lutar!"
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[16]
      value: Ja passamos por pior, podemos resistir!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[17]
      value: Eles quase venceram, mas so quase!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[18]
      value: Segurem ate o ultimo homem, ate o ultimo suspiro!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[19]
      value: Estamos sangrando, mas ainda nao derrotados!
      objectReference: {fileID: 0}
    - target: {fileID: 6248373325339093149, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: m_AnchorMax.x
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6248373325339093149, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: m_AnchorMax.y
      value: 0
