    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[0]
      value: Estamos sendo pressionados dos dois lados!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[1]
      value: "N\xE3o conseguimos segurar por muito mais tempo!"
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[2]
      value: Cada centimetro esta sendo disputado!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[3]
      value: Eles nao recuam!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[4]
      value: Fogo cruzado intenso, abaixem-se!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[5]
      value: Avancem! Nao podemos parar agora!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[6]
      value: E agora ou nunca!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[7]
      value: As linhas estao colapsando!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[8]
      value: "Sem refor\xE7os, estamos por conta propria!"
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[9]
      value: A luta esta corpo a corpo!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[10]
      value: Explosoes por toda parte!
      objectReference: {fileID: 0}
    - target: {fileID: 624333525053233812, guid: 29bae5a908c00d246b6e1482c53fc8b8, type: 3}
      propertyPath: randomPhrases.Array.data[11]
